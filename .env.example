# Ujobs India - Environment Variables

# API Configuration
NEXT_PUBLIC_API_URL=https://ujobsindia.com/aayusha-backend/public/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Ujobs India

# Analytics (Add your IDs)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=

# App Store Links
NEXT_PUBLIC_PLAYSTORE_URL=https://play.google.com/store/apps/details?id=com.ujobs.india
NEXT_PUBLIC_APPSTORE_URL=https://apps.apple.com/in/app/ujobs-india

# Contact
NEXT_PUBLIC_CONTACT_EMAIL=support@ujobsindia.com
NEXT_PUBLIC_CONTACT_PHONE=+91-1234567890

# Features
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_SEO_LOGS=false

# Server-only variables (never exposed to client)
REVALIDATE_SECRET=your-revalidate-secret-here
INTERNAL_API_KEY=your-internal-api-key-here
